<Window
    x:Class="Files.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Files.Core"
    Title="Files · 文件管理器">
  <Grid x:Name="Root" Loaded="OnLoaded" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.KeyboardAccelerators>
      <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="FocusAddress" />
      <KeyboardAccelerator Key="F5" Invoked="RefreshAccelerator" />
      <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="BackAccelerator" />
      <KeyboardAccelerator Key="Right" Modifiers="Menu" Invoked="ForwardAccelerator" />
    </Grid.KeyboardAccelerators>
    <NavigationView x:Name="Sidebar" PaneDisplayMode="Auto"
        OpenPaneLength="240" CompactPaneLength="48"
        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
        SelectionChanged="OnLocationChanged" IsEnabled="{Binding CanInteract}">
      <NavigationView.PaneHeader>
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,16,0,24">
          <FontIcon Glyph="&#xE8B7;" FontSize="28" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          <StackPanel>
            <TextBlock Text="Files" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock Text="你的文件，井然有序" Opacity="0.65" FontSize="12" />
          </StackPanel>
        </StackPanel>
      </NavigationView.PaneHeader>
      <NavigationView.PaneFooter>
        <StackPanel Margin="12" Spacing="8">
          <ComboBox x:Name="ThemeChoice" Header="外观" SelectedIndex="0"
              HorizontalAlignment="Stretch" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="跟随系统" />
            <ComboBoxItem Content="浅色" />
            <ComboBoxItem Content="深色" />
          </ComboBox>
          <ToggleSwitch x:Name="HiddenToggle" Header="隐藏项目" Toggled="OnHiddenChanged" />
        </StackPanel>
      </NavigationView.PaneFooter>
      <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Content="&#xE72B;" FontFamily="Segoe Fluent Icons"
              AutomationProperties.Name="后退" ToolTipService.ToolTip="后退（Alt+←）"
              IsEnabled="{Binding CanGoBack}" Click="GoBack" />
          <Button Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe Fluent Icons"
              AutomationProperties.Name="前进" ToolTipService.ToolTip="前进（Alt+→）"
              IsEnabled="{Binding CanGoForward}" Click="GoForward" />
          <Button Grid.Column="2" Content="&#xE74A;" FontFamily="Segoe Fluent Icons"
              AutomationProperties.Name="上一级" ToolTipService.ToolTip="上一级"
              IsEnabled="{Binding CanGoUp}" Click="GoUp" />
          <Button Grid.Column="3" Content="&#xE72C;" FontFamily="Segoe Fluent Icons"
              AutomationProperties.Name="刷新" ToolTipService.ToolTip="刷新（F5）" Click="Refresh" />
          <TextBox x:Name="Address" Grid.Column="4" Text="{Binding CurrentPath, Mode=OneWay}"
              PlaceholderText="输入文件夹路径，按 Enter 打开" KeyDown="OnAddressKeyDown"
              AutomationProperties.Name="文件夹路径" />
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" PlaceholderText="筛选当前文件夹中的名称"
              AutomationProperties.Name="筛选文件" TextChanged="OnFilterChanged" />
          <Button Grid.Column="1" Content="新建文件夹" Click="CreateFolder" />
        </Grid>
        <CommandBar Grid.Row="2" DefaultLabelPosition="Right" HorizontalContentAlignment="Left">
          <AppBarButton x:Name="OpenButton" Icon="OpenFile" Label="打开" IsEnabled="False" Click="OpenSelected" />
          <AppBarButton x:Name="CopyButton" Icon="Copy" Label="复制" IsEnabled="False" Click="CopySelected" />
          <AppBarButton x:Name="PasteButton" Icon="Paste" Label="粘贴" Click="Paste" />
          <AppBarSeparator />
          <AppBarButton x:Name="RenameButton" Icon="Edit" Label="重命名" IsEnabled="False" Click="RenameSelected" />
          <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="移到回收站" IsEnabled="False" Click="DeleteSelected" />
        </CommandBar>
        <InfoBar Grid.Row="3" IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False"
            Severity="Warning" Title="操作提示" Message="{Binding Error}" />
        <Grid Grid.Row="4">
          <ListView x:Name="FileList" ItemsSource="{Binding Entries}" SelectionMode="Multiple"
              SelectionChanged="OnSelectionChanged" DoubleTapped="OnDoubleTapped" KeyDown="OnListKeyDown"
              HorizontalContentAlignment="Stretch" AutomationProperties.Name="文件和文件夹">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="core:FileEntry">
                <Grid Padding="8,10" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="24" VerticalAlignment="Center"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                  <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Kind}" FontSize="12" Opacity="0.6" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" HorizontalAlignment="Right" Spacing="3">
                    <TextBlock Text="{x:Bind SizeText}" HorizontalAlignment="Right" />
                    <TextBlock Text="{x:Bind ModifiedText}" FontSize="11" Opacity="0.6"
                        TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <ProgressRing IsActive="{Binding IsLoading}" Width="36" Height="36"
              HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
        <TextBlock Grid.Row="5" Text="{Binding Status}" FontSize="12" Opacity="0.65"
            TextWrapping="Wrap" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
